# Copy to .env for local development. Real env vars override these.
PORT=8080
APP_ENV=development

# Postgres connection (matches docker-compose.yml)
# Note: host port 5434 (5432/5433 are often taken by a native Postgres/other container)
DATABASE_URL=postgres://kuriftu:kuriftu@localhost:5434/kuriftu?sslmode=disable

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRY=168h

# Comma-separated list of allowed CORS origins (the Next.js apps)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Chapa payment gateway. Leave CHAPA_SECRET_KEY empty to run in mock mode
# (checkout simulated locally, no real account needed). Set a CHASECK_TEST-...
# key to use Chapa's real test API.
CHAPA_SECRET_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Secret hash for verifying Chapa webhook signatures (Chapa dashboard ->
# webhook settings). Leave empty in dev/mock mode to skip verification.
CHAPA_WEBHOOK_SECRET=
